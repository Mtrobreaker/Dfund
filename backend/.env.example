# Database Configuration (PostgreSQL by default, falls back to SQLite if unreachable)
DATABASE_URL=postgresql+asyncpg://dfund_user:dfund_secure_password@localhost:5432/dfund_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./dfund_dev.db

# Sarvam AI Credentials (Full Indian Regional Voice & 105B AI Reasoning Suite)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
