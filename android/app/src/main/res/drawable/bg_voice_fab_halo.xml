<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glowing Halo Ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/voice_halo_bg" />
            <stroke android:width="2dp" android:color="@color/voice_halo_ring" />
            <size android:width="68dp" android:height="68dp" />
        </shape>
    </item>
    <!-- Inner Green Core Button -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/voice_fab_start"
                android:endColor="@color/voice_fab_end"
                android:type="linear" />
            <size android:width="56dp" android:height="56dp" />
        </shape>
    </item>
</layer-list>
