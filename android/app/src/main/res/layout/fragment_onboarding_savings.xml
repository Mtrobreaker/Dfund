<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/savings_pref_title"
                android:textColor="@color/primary_dark_green"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Info Banner (matching Image 6) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_light_green"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light_green"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Seedling"
                        android:src="@drawable/ic_seedling"
                        app:tint="@color/primary_dark_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="@string/savings_pref_banner"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 1: Desired Savings -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/desired_savings_title"
                android:textColor="@color/primary_dark_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/canvas_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light_green"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹"
                        android:textColor="@color/primary_dark_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etSavings"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="5,000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Chips for Savings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipSave500"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+₹500"
                    android:textColor="@color/primary_dark_green"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/border_light_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipSave1000"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+₹1,000"
                    android:textColor="@color/primary_dark_green"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/border_light_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipSave2000"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+₹2,000"
                    android:textColor="@color/primary_dark_green"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/border_light_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipSave5000"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="+₹5,000"
                    android:textColor="@color/primary_dark_green"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/border_light_green" />
            </LinearLayout>

            <!-- Section 2: Desired Investment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/desired_invest_title"
                android:textColor="@color/primary_dark_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInvestInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/canvas_white"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light_green"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹"
                        android:textColor="@color/primary_dark_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etInvest"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="2,000"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_muted"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Not ready to invest checkbox (Image 6) -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbNotReadyToInvest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/not_ready_to_invest"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                app:useMaterialThemeColors="true" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/primary_dark_green"
            android:text="@string/see_my_plan"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
