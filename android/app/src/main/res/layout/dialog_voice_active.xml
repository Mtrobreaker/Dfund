<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="24dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardElevation="16dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_dialog_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Pulsing Microphone Indicator -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginVertical="20dp">

            <View
                android:id="@+id/view_mic_pulse"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_voice_fab"
                android:alpha="0.25" />

            <!-- Circular Inner Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/brand_blue"
                app:cardCornerRadius="36dp"
                app:cardElevation="4dp">

                <ImageView
                    android:id="@+id/iv_voice_mic_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_mic"
                    android:layout_gravity="center"
                    app:tint="@color/on_primary" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Status / Listening text -->
        <TextView
            android:id="@+id/tv_voice_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_listening"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Spoken / Prompt Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_voice_prompt"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/brand_blue"
            android:hint="Speak or type instruction...">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_voice_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:imeOptions="actionSend"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Suggested Voice Prompts Chips -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Test Commands:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_prompt_sip"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                android:text="Calculate SIP for ₹500 for 3 years" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_prompt_tamil"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                android:text="தமிழ்: மாதம் 500 ரூபாய்க்கு SIP போடு" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_prompt_emi"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                android:text="Check my upcoming EMIs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_prompt_food"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeColor="@color/chip_stroke"
                app:chipStrokeWidth="1dp"
                android:text="Show my food expenses" />
        </LinearLayout>

        <!-- AI Response & Tamil Translation Card (Visible on Success) -->
        <LinearLayout
            android:id="@+id/layout_ai_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <!-- Tamil Translation from Sarvam -->
            <LinearLayout
                android:id="@+id/layout_tamil_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_pill_badge"
                android:padding="10dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 Sarvam Tamil Translation:"
                    android:textColor="@color/brand_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tamil_translation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Ollama Minimax-M3 Financial Suggestion Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/growth_emerald_border"
                app:strokeWidth="1.5dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Ollama AI Advice (Minimax-M3):"
                        android:textColor="@color/growth_emerald"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_ai_suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_execute_action"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="🚀 Execute Action"
                        android:textColor="@color/on_primary"
                        android:textStyle="bold"
                        android:backgroundTint="@color/growth_emerald"
                        app:cornerRadius="10dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_voice_close"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:text="@string/btn_close" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_voice_submit"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Submit / Ask"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/brand_blue"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
